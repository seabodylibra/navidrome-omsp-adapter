NAVIDROME_URL=http://192.168.1.100:4533
NAVIDROME_USERNAME=cloudshare-readonly
NAVIDROME_PASSWORD=change-me
# Generate with: openssl rand -hex 32
OMSP_TOKEN=replace-with-a-long-random-token
PORT=3000
LOG_LEVEL=info
# Optional. Use the adapter URL that Cloud Share devices can reach, including reverse-proxy path if applicable.
# PUBLIC_URL=https://music-adapter.example.com
# redirect (default) avoids relaying audio bytes through the adapter. proxy preserves Range if client cannot follow Navidrome redirects.
STREAM_MODE=redirect
# Optional: show Navidrome albums in Cloud Share's existing library playlist list. Defaults to false for compatibility.
EXPOSE_ALBUMS_IN_LIBRARY=false
# Maximum album rows scanned and exposed when browsing is enabled (1–10000; default 2000).
ALBUM_BROWSE_LIMIT=2000
# Optional stable URL origin for media links; if unset, a validated request host is used.
# PUBLIC_URL=http://192.168.1.50:3000
